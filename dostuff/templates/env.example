# DoStuff secrets. Keep this file private (chmod 600 on Unix); never commit it.
# Read from ~/.dostuff/.env and <project>/.dostuff/.env; project values override user values,
# and real environment variables override both.
# Uncomment the key for the provider you use. Other providers: https://docs.litellm.ai/docs/providers

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# Optional: override the active model from config.yaml
# MODEL=openai/gpt-4o-mini
